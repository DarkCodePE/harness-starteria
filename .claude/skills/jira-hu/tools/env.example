# Credenciales de Jira Cloud. Copiar a .env (chmod 600) o exportar al entorno.
# Lo exportado al entorno GANA sobre el .env. NUNCA commitear el .env con valores.
# En un worktree, apuntá al .env del checkout principal con: export JIRA_ENV_FILE=/ruta/al/.env
JIRA_HOSTNAME=
JIRA_USERNAME=
# Token personal de API: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Forma del equipo (jira-hu-crear.mjs). Los accountId salen de: node jira-hu-crear.mjs --usuarios
JIRA_PROJECT=KAN
JIRA_FUNCIONAL_ACCOUNT_ID=
JIRA_TECNICO_ACCOUNT_ID=
# Opcionales, si el proyecto nombra distinto sus tipos:
# JIRA_TIPO_HU=Tarea
# JIRA_TIPO_SUBTAREA=Subtask

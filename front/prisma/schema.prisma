  updatedAt      DateTime         @updatedAt

  @@unique([runId, fieldPath])
  @@index([projectId, status])
}

// Company context models. Personal companies are owned by ownerUserId; official
// companies are scoped to organizationId. Initiative snapshots are immutable and
// intentionally restricted from cascading deletes.

model Company {
  id               String        @id @default(cuid())
  name             String
  slug             String
  normalizedDomain String?
  sector           String
  country          String
  employeeRange    String?
  websiteUrl       String?
  linkedinUrl      String?
  ownerUserId      String?
  organizationId   String?
  scope            CompanyScope  @default(PERSONAL)
  status           CompanyStatus @default(ACTIVE)
  originCompanyId  String?
  originAuthorId   String?
  clonedFromAt     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  memberships   CompanyMembership[]
  versions      CompanyContextVersion[]
  entries       CompanyContextEntry[]
  areas         CompanyArea[]
  sources       ContextSource[]
  snapshots     InitiativeContextSnapshot[]
  contributions CompanyContribution[]

  @@index([ownerUserId])
  @@index([organizationId])
  @@index([scope])
  @@index([status])
  @@index([normalizedDomain])
}

model CompanyMembership {
  id               String                  @id @default(cuid())
  companyId        String
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId           String
  role             CompanyMembershipRole   @default(VIEWER)
  status           CompanyMembershipStatus @default(PENDING)
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([status])
}

model CompanyContextVersion {
  id                 String                      @id @default(cuid())
  companyId          String
  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  versionNumber      Int
  status             CompanyContextVersionStatus @default(DRAFT)
  contextScore       Int                         @default(0)
  contextLevel       CompanyContextLevel         @default(INITIAL)
  snapshotJson       Json
  scoreBreakdownJson Json?
  missingJson        Json?
  createdByUserId    String
  publishedByUserId  String?
  createdAt          DateTime                    @default(now())
  publishedAt        DateTime?

  entries   CompanyContextEntry[]
  snapshots InitiativeContextSnapshot[]

  @@unique([companyId, versionNumber])
  @@index([companyId])
  @@index([status])
}

model CompanyContextEntry {
  id                 String                    @id @default(cuid())
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  versionId          String?
  version            CompanyContextVersion?    @relation(fields: [versionId], references: [id], onDelete: SetNull)
  dimension          CompanyContextDimension
  fieldKey           String
  valueJson          Json
  sourceType         CompanyContextSourceType
  sourceId           String?
  source             ContextSource?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  confidence         Float?
  verificationStatus ContextVerificationStatus @default(UNVERIFIED)
  createdByUserId    String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([companyId])
  @@index([versionId])
  @@index([sourceId])
  @@index([dimension, fieldKey])
}

model CompanyArea {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  leadRole    String?
  status      CompanyAreaStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  contexts  CompanyAreaContext[]

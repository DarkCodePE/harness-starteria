// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String?
  googleId            String?   @unique
  role                Role
  initials            String
  skills              String[]
  bio                 String?
  avatarUrl           String?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  cohortId            String?
  cohort              Cohort?   @relation(fields: [cohortId], references: [id])
  // ADR-022: primary B2B organization (denormalized convenience pointer). Plain
  // scalar (NOT a relation, NOT @unique) — additive & safe for `prisma db push`
  // (ADR-018). Authoritative membership lives in OrganizationMember.
  organizationId      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  projects                 Project[]
  teamMemberships          TeamMember[]
  challengeTeamMemberships ChallengeTeamMember[] // ADR-023: reto-scoped team membership
  mentorSessions           MentorSession[]
  evidence                 Evidence[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  helpRequests             HelpRequest[]         @relation("HelpRequester")
  mentorHelpRequests       HelpRequest[]         @relation("HelpMentor")
  sponsorCheckpoints       SponsorCheckpoint[]   @relation("SponsorCheckpoints")
  initialReviews           InitialReview[] // ADR-025: revisiones iniciales del usuario

  @@index([email])
  @@index([role])
  @@index([cohortId])
  @@index([googleId])
  @@index([organizationId])
}

model Project {
  id                      String            @id @default(cuid())
  name                    String
  description             String?
  status                  ProjectStatus     @default(DRAFT)
  currentStep             Int               @default(0)
  step0Status             Step0Status       @default(NOT_STARTED)
  step0Data               Json?
  // Set when this project was created by redeeming a pilot code (ADR-018).
  // Plain index (NOT @unique): adding a unique constraint trips `prisma db push`'s
  // data-loss guard and aborts the deploy. Idempotency is enforced in the claim
  // service instead (claim.createdProjectId + a findFirst guard before creating).
  pilotLeadId             String?
  mentorCredits           Int               @default(3)
  riskLevel               RiskLevel?
  isArchived              Boolean           @default(false)
  lastPosition            Json?
  sponsorTouchpoints      Json?
  sponsorComments         Json?
  // ADR-025: procedencia de la iniciativa + snapshot de la revisión inicial que la
  // originó (nullable → additivo, seguro para `prisma db push`).
  origin                  InitiativeOrigin? @default(from_scratch)
  initialReviewSnapshotId String?
  createdAt               DateTime          @default(now())
  lastModified            DateTime          @updatedAt

  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id])
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id])

  steps                 Step[]
  evidence              Evidence[]
  teamMembers           TeamMember[]
  mentorSessions        MentorSession[]
  helpRequests          HelpRequest[]
  sponsorCheckpoints    SponsorCheckpoint[]
  portfolioMeta         InitiativePortfolioMeta[]
  initiativePdfs        InitiativePdf[]
  initialReviewSnapshot InitialReviewSnapshot?      @relation("ProjectFromSnapshot", fields: [initialReviewSnapshotId], references: [id])
  routeConfirmation     RouteConfirmation?          @relation("ProjectRouteConfirmation")
  contextSources        ContextSource[]
  contextSnapshots      InitiativeContextSnapshot[]
  contextNotes          InitiativeContextNote[]
  adaptiveStepConfigurations AdaptiveStepConfiguration[]
  adaptiveCheckpointInstances AdaptiveCheckpointInstance[]
  adaptiveCheckpointResponses AdaptiveCheckpointResponse[]
  adaptiveStepOutputs AdaptiveStepOutput[]
  adaptiveProgressSignal AdaptiveProgressSignal?
  adaptiveEvents AdaptiveAdaptationEvent[]

  @@index([ownerId])
  @@index([cohortId])
  @@index([status])
  @@index([pilotLeadId])
  // Plain @@index (NOT @@unique): igual que `pilotLeadId`, agregar un @@unique a una
  // tabla EXISTENTE dispara el guard de data-loss de `prisma db push` y aborta el deploy
  // (el CD corre db push SIN --accept-data-loss). La idempotencia real (un snapshot →
  // ≤1 Project, RB-IR-017/018) ya la garantizan RouteConfirmation.reviewId @@unique + el
  // claim-antes-de-crear en RouteConfirmationService, así que el unique aquí era redundante.
  @@index([initialReviewSnapshotId])
}

model Step {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  name      String
  status    StepStatus @default(BLOCKED)
  progress  Int        @default(0)
  stepData  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  modules       Module[]
  runs          Run[]
  feedbackIA    FeedbackIA[]
  mentorSession MentorSession?

  @@unique([projectId, number])
  @@index([projectId])
}

model Module {
  id        String       @id @default(cuid())
  stepId    String
  step      Step         @relation(fields: [stepId], references: [id], onDelete: Cascade)
  moduleId  String
  name      String
  status    ModuleStatus @default(BLOCKED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([stepId, moduleId])
  @@index([stepId])
}

model AdaptiveStepConfiguration {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepNumber        Int
  version           Int
  status            String   @default("active")
  routeType         String
  depthLevel        String
  maturity          String?
  configurationJson Json
  sourceContextJson Json?
  requiresReview    Boolean  @default(false)
  supersededById    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  checkpointInstances AdaptiveCheckpointInstance[]
  stepOutputs         AdaptiveStepOutput[]

  @@unique([projectId, stepNumber, version])
  @@index([projectId])
  @@index([projectId, stepNumber, status])
}

model AdaptiveCheckpointInstance {
  id                     String   @id @default(cuid())
  projectId              String
  project                Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepConfigurationId    String
  stepConfiguration      AdaptiveStepConfiguration @relation(fields: [stepConfigurationId], references: [id], onDelete: Cascade)
  stepNumber             Int
  checkpointKey          String
  sequence               Int
  status                 String   @default("ready")
  materializedQuestionsJson Json
  sufficiencyJson        Json?
  startedAt              DateTime @default(now())
  completedAt            DateTime?
  idempotencyKey         String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  responses AdaptiveCheckpointResponse[]

  @@unique([projectId, stepConfigurationId, checkpointKey])
  @@index([projectId])
  @@index([projectId, status])
}

model AdaptiveCheckpointResponse {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpointInstanceId String
  checkpointInstance   AdaptiveCheckpointInstance @relation(fields: [checkpointInstanceId], references: [id], onDelete: Cascade)
  checkpointKey        String
  responseJson         Json
  answeredById         String?
  idempotencyKey       String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId])
  @@index([checkpointInstanceId])
}

model AdaptiveStepOutput {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceConfigurationId String?
  sourceConfiguration   AdaptiveStepConfiguration? @relation(fields: [sourceConfigurationId], references: [id], onDelete: SetNull)
  stepNumber            Int
  version               Int
  status                String   @default("draft")
  outputKey             String
  outputJson            Json
  confirmedById         String?
  confirmedAt           DateTime?
  requiresReview        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, stepNumber, version])
  @@index([projectId])
  @@index([projectId, stepNumber, status])
}

model AdaptiveProgressSignal {
  id            String   @id @default(cuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepNumber    Int
  checkpointKey String?
  health        String
  signalJson    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdaptiveAdaptationEvent {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventType      String
  eventKey       String?
  summary        String?
  payloadJson    Json
  createdById    String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([projectId, eventType])
  @@index([createdAt])
}

model FeedbackIA {
  id             String         @id @default(cuid())
  stepId         String
  step           Step           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status         FeedbackStatus
  summary        String
  goodPoints     String[]
  missing        String[]
  actions        String[]
  questions      String[]
  contradictions String[]
  createdAt      DateTime       @default(now())

  @@index([stepId])
}

model MentorSession {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepId       String         @unique
  step         Step           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepNumber   Int
  mentorId     String
  mentor       User           @relation(fields: [mentorId], references: [id])
  date         DateTime?
  status       SessionStatus  @default(PENDING_SCHEDULE)
  result       SessionResult?
  comments     String?
  rubricScores Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([projectId])
  @@index([mentorId])
  @@index([stepId])
}

model Evidence {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  type       EvidenceType
  size       String?
  url        String?
  storageKey String?
  stepRef    Int
  moduleRef  String?
  ownerId    String
  owner      User           @relation(fields: [ownerId], references: [id])
  status     EvidenceStatus @default(UPLOADED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([projectId])
  @@index([ownerId])
  @@index([stepRef])
}

model TeamMember {
  id                     String           @id @default(cuid())
  projectId              String
  project                Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User             @relation(fields: [userId], references: [id])
  role                   TeamRole         @default(VIEWER)
  status                 TeamMemberStatus @default(PENDING)
  invitedAt              DateTime         @default(now())
  joinedAt               DateTime?
  // ADR-023: marks rows materialized from the reto's ChallengeTeamMember at
  // create-iniciativa time (inheritance). Manual additions stay false (override).
  // Additive Boolean with default → safe for `prisma db push` (ADR-018).
  inheritedFromChallenge Boolean          @default(false)

  modulePermissions String[] // Module IDs the colaborador can edit

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Run {
  id           String    @id @default(cuid())
  stepId       String
  step         Step      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  name         String
  status       RunStatus @default(DRAFT)
  metrics      Json?
  learningCard Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([stepId])
}

model Cohort {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects Project[]
  users    User[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([family])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model HelpRequest {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("HelpRequester", fields: [userId], references: [id])
  mentorId  String?
  mentor    User?             @relation("HelpMentor", fields: [mentorId], references: [id])
  message   String
  response  String?
  status    HelpRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([mentorId])
  @@index([status])
}

model SponsorCheckpoint {
  id                  String                  @id @default(cuid())
  projectId           String
  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepNumber          Int
  sponsorId           String
  sponsor             User                    @relation("SponsorCheckpoints", fields: [sponsorId], references: [id])
  status              SponsorCheckpointStatus @default(PENDING)
  strategicFeedback   String?
  alignmentSignal     AlignmentSignal?
  focusRecommendation String?
  respondedAt         DateTime?
  expiresAt           DateTime
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([projectId, stepNumber])
  @@index([projectId])
  @@index([sponsorId])
  @@index([status])
}

// ─── Portfolio Lead Models ───────────────────────────────────────────────────

model StrategicFront {
  id                 String                 @id @default(cuid())
  name               String
  description        String?
  strategicObjective String?
  whyNow             String?
  mainKpi            String?
  baseline           String?
  target             String?
  horizon            String?
  sponsor            String?
  status             StrategicFrontStatus   @default(draft)
  priority           StrategicFrontPriority @default(Media)
  organizationId     String?
  ownerId            String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  challenges Challenge[]

  @@index([status])
  @@index([organizationId])
}

model Challenge {
  id                    String                  @id @default(cuid())
  strategicFrontId      String
  strategicFront        StrategicFront          @relation(fields: [strategicFrontId], references: [id], onDelete: Cascade)
  title                 String
  name                  String?
  description           String?
  type                  ChallengeType           @default(crecimiento)
  whatWeWantToMove      String?
  objective             String?
  whyNow                String?
  successCriteria       String?
  challengeOwner        String?
  challengeOwnerStatus  StakeholderStatus       @default(definido)
  sponsorStatus         StakeholderStatus       @default(definido)
  openCallStatus        ChallengeOpenCallStatus @default(inactiva)
  visibleToParticipants Boolean                 @default(false)
  publicationNotes      String?
  lastPublishedAt       DateTime?
  status                ChallengeStatus         @default(draft)
  activationMode        ChallengeActivationMode @default(convocatoria_abierta)
  coverageStatus        ChallengeCoverageStatus @default(sin_cobertura)
  sponsorId             String?
  ownerId               String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  selectedPeople   ChallengeInvitation[]
  assignedSquad    ChallengeSquadMember[]
  challengeTeam    ChallengeTeamMember[] // ADR-023: unified reto-scoped team (replaces assignedSquad)
  initiativeMetas  InitiativePortfolioMeta[]
  overlaps         InitiativeOverlap[]
  executiveOutputs ExecutiveOutput[]

  @@index([strategicFrontId])
  @@index([status])
}

model ChallengeInvitation {
  id          String            @id @default(cuid())
  challengeId String
  challenge   Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  value       String
  status      StakeholderStatus @default(definido)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([challengeId])
}

// DEPRECATED (ADR-023): superseded by ChallengeTeamMember. Kept read-only during the
// transition; backfilled into ChallengeTeamMember by backend/scripts/backfill-challenge-team.ts.
model ChallengeSquadMember {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  value       String
  role        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([challengeId])
}

// ADR-023: unified reto-scoped team. One canonical team owned by the Challenge (reto),
// inherited by its iniciativas (materialized into TeamMember at create-time, then
// overridable per-iniciativa). Reuses TeamRole/TeamMemberStatus (orthogonal to the
// ADR-009 6-role platform authz). `userId` is nullable for the squad-string transition.
// Logical uniqueness (challengeId, userId) is enforced in PortfolioService via a
// findFirst-guard, NOT @unique — `prisma db push` trips its data-loss guard on a
// @unique added to a populated table (ADR-018/020). Null-userId label rows may repeat.
model ChallengeTeamMember {
  id          String           @id @default(cuid())
  challengeId String
  challenge   Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  label       String? // free-text name/email when userId is unknown (backfill of squad value)
  role        TeamRole         @default(VIEWER)
  status      TeamMemberStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([challengeId])
  @@index([userId])
}

model InitiativePortfolioMeta {
  id                           String                     @id @default(cuid())
  projectId                    String
  project                      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  challengeId                  String
  challenge                    Challenge                  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  strategicFrontId             String?
  // Portfolio tracking fields
  teamOwner                    String?
  currentStep                  String?

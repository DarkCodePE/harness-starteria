// ─── Public pilot leads (ADR-015, PRD-003 / SPEC-003) ─────────────────────────
// Captura de interés en piloto desde el landing público (anónimo). Reemplaza la
// conversión pública borrador→proyecto. `draftId` es el id del borrador en
// localStorage (NO hay FK: el draft público no vive en DB). PII: email/phone —
// nunca en logs en claro; consentimiento explícito con timestamp obligatorio.
model PilotLead {
  id              String   @id @default(uuid())
  draftId         String   @unique
  pilotCode       String   @unique
  name            String
  email           String
  phone           String?
  organization    String?
  consentAccepted Boolean
  consentAt       DateTime
  status          String   @default("submitted")
  source          String   @default("public_landing")
  retentionUntil  DateTime
  // Snapshot of the public proposal/one-pager captured WITH the lead, so the
  // pilotCode can later be redeemed to resume the initiative (the draft itself
  // never lived server-side — only browser sessionStorage). Nullable: legacy
  // leads + partial captures degrade gracefully. Public-only content (the UI
  // forbids sensitive data en público), retained under `retentionUntil`.
  proposal        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([retentionUntil])
}

// ─── Pilot claim tokens (ADR-018) ─────────────────────────────────────────────
// Short-lived, single-use token minted when a pilot code is redeemed. It binds
// the lead server-side so its proposal can be imported into whoever authenticates,
// WITHOUT ever returning the lead's email/PII to the client. Only the SHA-256
// hash is stored (mirrors RefreshToken.tokenHash); the raw token lives client-side
// for the flow's duration. `consumedAt` + `createdProjectId` give single-use +
// idempotency. No relation fields kept intentionally (scalar FK + index suffice).
model PilotClaimToken {
  id               String    @id @default(uuid())
  tokenHash        String    @unique
  pilotLeadId      String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdProjectId String?
  createdAt        DateTime  @default(now())

  @@index([pilotLeadId])
  @@index([expiresAt])
}

// ─── Billing & Entitlements (ADR-020/021/022, PRD-005/SPEC-005) ────────────────
// Additive-only. `@unique` appears ONLY on brand-new tables (Plan.code,
// UsageEvent.dedupeKey) — never on User/Project — so `prisma db push`'s data-loss
// guard never trips (ADR-018). Logical uniqueness on existing tables is enforced
// in services (findFirst-guard), mirroring Project.pilotLeadId and RefreshToken.

enum BillingProvider {
  CULQI
  STRIPE
  YAPE
  MERCADO_PAGO
  MANUAL // admin-granted / grandfathered pilots
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PlanInterval {
  MONTH
  YEAR
}

// Catalog. New table → @unique on `code` is SAFE (no existing rows).
model Plan {
  id         String       @id @default(cuid())
  code       String       @unique // "free" | "starter" | "team" | "enterprise" | "pilot"
  name       String
  interval   PlanInterval @default(MONTH)
  priceCents Int          @default(0)
  currency   String       @default("PEN")
  isActive   Boolean      @default(true)
  // Typed JSON limit map: { "ai_refine": 40, "pdf_extract": 1, "project_create": 1,
  // "mentor_credit": 0, "seats": 1, "exec_export": 0 }. -1 = unlimited.
  limits     Json         @default("{}")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  subscriptions Subscription[]
}

// Held by EITHER a user OR an organization (B2B), never both. Exactly-one-active
// enforcement lives in SubscriptionService (no partial unique index — db push
// can't add one to a table that may hold rows post-launch).
model Subscription {
  id                 String             @id @default(cuid())
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  userId             String? // nullable scalar FK → User (no inverse relation, ADR-022)
  organizationId     String? // nullable FK → Organization (additive)
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  provider           BillingProvider    @default(MANUAL)
  providerCustomerId String?
  providerSubId      String? // provider subscription ref (indexed, NOT unique)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  usageCounters UsageCounter[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([provider, providerSubId])
}

// Per-feature usage within a billing period. Reset is implicit via periodKey.
// No @@unique (avoid db-push guard once rows exist); service upserts via
// findFirst-guard + atomic increment (ADR-020).
model UsageCounter {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  feature        String // "ai_refine" | "pdf_extract" | "project_create" | ...
  periodKey      String // "2026-06" (month) — the reset boundary
  used           Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@index([subscriptionId, feature, periodKey])
}

// Idempotency ledger for billable runs / credit spends. New table → @unique on
// dedupeKey is SAFE. A webhook re-delivery or double-submit counts ONCE.
model UsageEvent {
  id             String   @id @default(cuid())
  subscriptionId String?
  feature        String
  qty            Int      @default(1)
  dedupeKey      String   @unique // "ai_refine:<requestId>" / "pdf_extract:<aiRunId>"
  sourceId       String?
  createdAt      DateTime @default(now())

  @@index([subscriptionId, feature])
}

// Optional B2B owner of seats / a cohort. New table. `slug` uniqueness enforced
// in OrgService (findFirst guard), NOT @unique (deploy discipline).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String
  seatLimit Int      @default(1)
  cohortId  String? // links a paid org to an existing Cohort (seat pool = members)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  members       OrganizationMember[]

  @@index([cohortId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String // scalar FK; no inverse relation on User (ADR-022)
  role           String       @default("member") // "owner" | "admin" | "member"
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Revisión inicial guiada (ADR-025) — capa pre-Project. La revisión NO crea
// Project hasta que el usuario confirma la ruta; entonces RouteConfirmation
// delega en ProjectService.createProject (milestone #7). Reusa ChallengeType.
// ─────────────────────────────────────────────────────────────────────────────

enum InitialReviewStatus {
  draft
  processing
  generated
  updated
  route_confirmed
  converted_to_initiative
  abandoned
  failed
}

enum RouteConfirmationStatus {
  pending
  confirmed
  initiative_created
  failed
}

enum InitiativeOrigin {
  from_scratch
  from_initial_review
  from_public_draft
  imported
  linked_existing
  independent
}

enum InformationReadinessStatus {
  very_low
  low
  medium
  high
}

// ADR-026: emisor de un evento de la conversación de revisión inicial.
enum InitialReviewChatRole {
  assistant
  user
  system
}

// ADR-026: tipo de turno. Agregar valores es no-destructivo para `prisma db push`
// (la restricción de CD es sobre @@unique en tablas existentes, no sobre enums).
// v2 podrá sumar 'llm_reply' sin migración destructiva.
enum InitialReviewChatEventKind {
  guide // mensaje del asistente que dirige la agenda
  answer // respuesta del usuario a una pregunta estratégica
  context // contexto libre aportado por el usuario
  doubt // duda del usuario resuelta por catálogo (v1) / LLM (v2)
  diff_announcement // asistente anuncia qué secciones del snapshot cambiaron
  confirm // el usuario confirma la ruta desde el chat
}

model InitialReview {
  id                      String              @id @default(cuid())
  ownerId                 String
  // Restrict (default, como Project.owner): borrar un User NO debe cascadear y
  // destruir el rastro de una revisión ya convertida (audit trail, AC-S0-005).
  // El abandono usa status=abandoned (RB-IR-020), no un DELETE físico.
  owner                   User                @relation(fields: [ownerId], references: [id])
  status                  InitialReviewStatus @default(draft)
  originalInput           String
  addedContext            Json? // string[]
  sourceFileIds           Json? // string[]
  companyContextSelection Json?
  // Scalar FK suelto (patrón ADR-022) para no acoplar bounded contexts; indexado
  // para "revisiones de este reto".
  challengeId             String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  snapshots    InitialReviewSnapshot[]
  confirmation RouteConfirmation? // idempotente: a lo sumo una confirmación por revisión
  chatEvents   InitialReviewChatEvent[] // ADR-026: historial conversacional del asistente

  @@index([ownerId])
  @@index([status])
  @@index([challengeId])
}

// ADR-026 (IRC-01): historial event-sourced de la conversación del asistente sobre una
// revisión. Los mensajes del asistente son reconstruibles a partir del estado, pero se
// persisten para continuidad exacta multi-dispositivo y auditabilidad. Solo @@index
// (NUNCA @@unique en el flujo de CD `prisma db push` sin --accept-data-loss).
model InitialReviewChatEvent {
  id              String                     @id @default(cuid())
  reviewId        String
  review          InitialReview              @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  role            InitialReviewChatRole
  kind            InitialReviewChatEventKind
  payload         Json // { text?, questionId?, changedSections?, ... } — forma según kind
  snapshotVersion Int? // versión del snapshot vigente cuando se emitió el evento
  createdAt       DateTime                   @default(now())

  @@index([reviewId, createdAt])
}

model InitialReviewSnapshot {
  id                      String                      @id @default(cuid())
  reviewId                String
  review                  InitialReview               @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  version                 Int                         @default(1)
  originalInput           String
  // Contexto/fuentes CONGELADOS en el snapshot (PRD §18): releer una versión debe
  // reflejar el contexto que la produjo, aunque el InitialReview padre cambie.
  addedContext            Json? // string[]
  sourceFileIds           Json? // string[]
  companyContextSelection Json?
  understandingSummary    String
  understandingConfirmed  Boolean                     @default(false)
  suggestedChallengeType  ChallengeType
  selectedChallengeType   ChallengeType
  challengeTypeReason     String // se genera junto al tipo → requerido
  informationReadiness    InformationReadinessStatus?
  critique                Json // ExpertCritique { solid, weak, risky, recommendedAdjustment, mainRisk }
  strategicQuestions      Json // StrategicQuestion[]
  improvedProposal        Json // ImprovedProposal { suggestedName, improvedDescription, initialFocus, expectedImpact, nextRecommendedStep }
  routePreview            Json // StepRoutePreviewItem[]
  createdBy               String
  createdAt               DateTime                    @default(now())

  routeConfirmations RouteConfirmation[]
  projects           Project[]           @relation("ProjectFromSnapshot")

  @@unique([reviewId, version])
  @@index([reviewId])
}

model RouteConfirmation {
  id                       String                  @id @default(cuid())
  reviewId                 String                  @unique // idempotencia (RB-IR-017/018): 1 confirmación por revisión
  review                   InitialReview           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  snapshotId               String
  snapshot                 InitialReviewSnapshot   @relation(fields: [snapshotId], references: [id])
  confirmedBy              String
  confirmedAt              DateTime                @default(now())
  selectedChallengeType    ChallengeType
  acceptedImprovedProposal Boolean                 @default(true)
  createdProjectId         String?                 @unique
  createdProject           Project?                @relation("ProjectRouteConfirmation", fields: [createdProjectId], references: [id])
  status                   RouteConfirmationStatus @default(pending)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([snapshotId])
  @@index([status])
}

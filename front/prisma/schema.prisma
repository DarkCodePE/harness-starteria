model CompanyAreaContext {
  id               String      @id @default(cuid())
  areaId           String
  area             CompanyArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  version          Int         @default(1)
  purpose          String?
  autonomyLevel    String?
  dependenciesJson Json?
  prioritiesJson   Json?
  createdByUserId  String

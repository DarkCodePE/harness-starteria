        <mxCell id="t_f1" value="&lt;b&gt;FRONTERA 1&lt;/b&gt; — doc/ NO entra al brain&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ADR-010 §2.3 · crearía la copia que envejece&lt;br/&gt;en silencio, que es lo que ADR-005 prohíbe&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">

        <mxCell id="t_title" value="&lt;b&gt;El backend MCP no hay que construirlo: ya existe.&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gbrain 0.50 trae servidor MCP (stdio / http), 6 perfiles, cercos de escritura por prefijo de slug,&lt;br/&gt;lectura federada por fuente, presupuesto diario y TTL de token. Falta otorgarlo y cercarlo, no escribirlo.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="900" height="70" as="geometry"/>
